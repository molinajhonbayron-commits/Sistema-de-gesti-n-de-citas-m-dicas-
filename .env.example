# Copia este archivo como .env y ajusta los valores
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos: SQLite (db.sqlite3), se crea sola con "python manage.py migrate".
# No requiere configuración ni conexión externa.

# Correo (recordatorios). En desarrollo los correos salen por consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=citas@clinica.local
# Para correo real (ejemplo Gmail), cambia el backend y descomenta:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_clave_de_aplicacion
